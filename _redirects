# PasTele / TeleCod — canonical public content rewrites
# IMPORTANT: destination uses extensionless routes because Cloudflare Pages
# automatically normalizes *.html URLs to extensionless URLs.

/p/* /paste-view?slug=:splat 200
/c/p/* /product?type=code&slug=:splat 200
/c/f/* /product?type=code&slug=:splat 200
/ch/p/* /product?type=channel&slug=:splat 200
/ch/f/* /product?type=channel&slug=:splat 200
/g/p/* /product?type=group&slug=:splat 200
/g/f/* /product?type=group&slug=:splat 200
/paste/* /product?type=paste&slug=:splat 200
